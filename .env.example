# ─── Supabase (obligatorio) ────────────────────────────────────────────
# Panel de Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role: SOLO servidor. Necesaria para notificaciones, recordatorios,
# subida de imágenes y creación de usuarios del panel. Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (enlaces en correos, QR, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Recordatorios automáticos ────────────────────────────────────────
# Secreto que debe enviar el cron en la cabecera Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ─── Correo electrónico (opcional) — https://resend.com ───────────────
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Onyx Barber <reservas@tudominio.cl>"
EMAIL_FROM=

# ─── WhatsApp (opcional) — Twilio WhatsApp API ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número habilitado para WhatsApp en Twilio, p. ej. +14155238886 (sandbox)
TWILIO_WHATSAPP_FROM=
